# Privacy-first allowlist. Everything is private unless explicitly allowed.
/*

!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/CHANGELOG.md
!/CONTRIBUTING.md
!/SECURITY.md
!/CODE_OF_CONDUCT.md
!/AGENTS.md
!/pyproject.toml
!/JOB_SYSTEM.md
!/PROJECT_RULES.md

!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml
!/.github/dependabot.yml

!/config/
/config/*
!/config/settings.example.toml
!/config/public-audit.example.toml

!/docs/
/docs/*
!/docs/*.md

!/examples/
/examples/*
!/examples/*.md
!/examples/*.json

!/prompts/
/prompts/*
!/prompts/*.md

!/scripts/
/scripts/*
!/scripts/jobctl.py
!/scripts/jobsearch_config.py
!/scripts/search_coverage.py
!/scripts/public_audit.py
!/scripts/qa_dashboard.mjs

!/tests/
/tests/*
!/tests/test_*.py
